@import "tailwindcss";

@layer base {
  :root {
    --font-sans: "DM Sans", -apple-system, BlinkMacSystemFont, sans-serif;
    --font-serif: "Playfair Display", Georgia, serif;
    --font-mono: "JetBrains Mono", monospace;
  }

  body {
    font-family: var(--font-sans);
    color: #f0ede8;
    background-color: #0f1b2d;
    overflow-x: hidden;
  }

  h1,
  h2,
  h3,
  .font-display {
    font-family: var(--font-sans);
  }
}

/* ============================================================
   SCROLLBARS PERSONNALISÉES
   ============================================================ */
::-webkit-scrollbar {
  width: 6px;
  height: 6px;
}
::-webkit-scrollbar-track {
  background: rgba(15, 27, 45, 0.5);
}
::-webkit-scrollbar-thumb {
  background: #2a3f5c;
  border-radius: 9999px;
}
::-webkit-scrollbar-thumb:hover {
  background: #3a5270;
}

/* ============================================================
   IMPRESSION — STYLE UNIVERSEL POUR TOUS LES DOCUMENTS
   Compatible : fiches, quittances, contrats, bulletins, PV, etc.
   ============================================================ */
@page {
  size: A4 portrait;
  margin: 7mm;
}

@media print {
  html,
  body {
    background: #ffffff !important;
    color: #000000 !important;
    margin: 0 !important;
    padding: 0 !important;
    width: 100% !important;
    height: auto !important;
    overflow: visible !important;
    -webkit-print-color-adjust: exact !important;
    print-color-adjust: exact !important;
  }

  body * {
    visibility: hidden !important;
  }

  .print-container,
  .print-container *,
  .print-area,
  .print-area *,
  .printable,
  .printable * {
    visibility: visible !important;
  }

  .print-container,
  .print-area,
  .printable {
    position: static !important;
    left: 0 !important;
    top: 0 !important;
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
    background: #ffffff !important;
    color: #000000 !important;
    box-shadow: none !important;
    border: none !important;
    border-radius: 0 !important;
    overflow: visible !important;
    max-height: none !important;
    height: auto !important;
    font-size: 11px !important;
  }

  /* Si une zone d'impression est active, masquer le flux principal de l'app pour éviter tout espace blanc */
  body:has(.print-container) .min-h-screen > aside,
  body:has(.print-container) .min-h-screen > nav,
  body:has(.print-container) .min-h-screen > header,
  body:has(.print-container) .min-h-screen > div.flex-1 {
    display: none !important;
  }

  /* Débloquer les conteneurs parents de print-container */
  div:has(> .print-container),
  div:has(> * > .print-container),
  div:has(> * > * > .print-container) {
    overflow: visible !important;
    max-height: none !important;
    height: auto !important;
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
    padding: 0 !important;
    margin: 0 !important;
  }

  .quittance-copy {
    width: 100% !important;
    max-width: 100% !important;
    page-break-inside: avoid !important;
    break-inside: avoid !important;
    overflow: hidden !important;
    margin: 0 !important;
    padding: 0 !important;
    max-height: 133mm !important;
    box-sizing: border-box !important;
  }

  .quittance-copy + .quittance-copy {
    margin-top: 2mm !important;
  }

  .cut-line {
    margin: 2mm 0 !important;
    font-size: 8px !important;
    letter-spacing: 0.1em !important;
    text-align: center !important;
    border-top: 1px dashed #777777 !important;
    border-bottom: 1px dashed #777777 !important;
    padding: 1mm 0 !important;
    page-break-inside: avoid !important;
    break-inside: avoid !important;
  }

  .copy-label {
    text-align: center !important;
    font-size: 7.5px !important;
    font-weight: bold !important;
    color: #555555 !important;
    margin-top: 0.5mm !important;
  }

  .fixed,
  .fixed.inset-0,
  [class*="fixed"] {
    position: static !important;
    overflow: visible !important;
    background: transparent !important;
    backdrop-filter: none !important;
    padding: 0 !important;
    margin: 0 !important;
    max-height: none !important;
    height: auto !important;
    max-width: none !important;
    width: auto !important;
    z-index: auto !important;
    inset: auto !important;
  }

  /* Support bulletins et états imprimables */
  .bulletin-print-modal {
    display: block !important;
    position: static !important;
    width: 100% !important;
    max-width: 100% !important;
    max-height: none !important;
    height: auto !important;
    overflow: visible !important;
    background: #ffffff !important;
    border: none !important;
    box-shadow: none !important;
    padding: 0 !important;
    margin: 0 !important;
  }

  .bulletin-print-container {
    display: block !important;
    max-height: none !important;
    height: auto !important;
    overflow: visible !important;
    page-break-after: auto !important;
    break-after: auto !important;
    page-break-inside: auto !important;
    break-inside: auto !important;
  }

  .print-container *,
  .print-area *,
  .printable * {
    color: #000000 !important;
    background-color: transparent !important;
    border-color: #cccccc !important;
    box-shadow: none !important;
    text-shadow: none !important;
  }

  /* Tableaux */
  .print-container table,
  .print-area table,
  .printable table {
    border-collapse: collapse !important;
    width: 100% !important;
  }
  .print-container th,
  .print-container td,
  .print-area th,
  .print-area td,
  .printable th,
  .printable td {
    border: 1px solid #999999 !important;
    padding: 6px 8px !important;
    color: #000000 !important;
    background: #ffffff !important;
  }
  .print-container thead,
  .print-area thead,
  .printable thead {
    background: #eeeeee !important;
    display: table-header-group !important;
  }
  .print-container thead *,
  .print-area thead *,
  .printable thead * {
    background: #eeeeee !important;
    color: #000000 !important;
    font-weight: bold !important;
  }

  /* Fonds sombres des badges → gris clair */
  .print-container .bg-\[\#1E2E45\],
  .print-container .bg-\[\#162133\],
  .print-container .bg-\[\#0F1B2D\],
  .print-container .bg-\[\#0A111D\],
  .print-area .bg-\[\#1E2E45\],
  .print-area .bg-\[\#162133\],
  .print-area .bg-\[\#0F1B2D\],
  .print-area .bg-\[\#0A111D\],
  .printable .bg-\[\#1E2E45\],
  .printable .bg-\[\#162133\],
  .printable .bg-\[\#0F1B2D\],
  .printable .bg-\[\#0A111D\] {
    background: #f5f5f5 !important;
  }

  /* Texte blanc ou coloré → noir */
  .print-container [class*="text-white"],
  .print-container [class*="text-slate"],
  .print-container [class*="text-\\[\\#"],
  .print-area [class*="text-white"],
  .print-area [class*="text-slate"],
  .print-area [class*="text-\\[\\#"],
  .printable [class*="text-white"],
  .printable [class*="text-slate"],
  .printable [class*="text-\\[\\#"] {
    color: #000000 !important;
  }

  /* ---------- 7. CACHER LES ÉLÉMENTS NON IMPRIMABLES ---------- */
  .no-print,
  .no-print *,
  nav,
  aside,
  .sidebar {
    display: none !important;
  }

  /* ⚠️ Ne pas cacher "header" et "button" globalement — certains documents en ont besoin */

  /* ---------- 8. AFFICHER CE QUI DOIT L'ÊTRE ---------- */
  .print-only {
    display: block !important;
  }

  /* ---------- 9. SAUTS DE PAGE ---------- */
  .print-page-break {
    page-break-before: always !important;
    break-before: page !important;
  }
  .print-page {
    page-break-inside: avoid !important;
    break-inside: avoid !important;
  }

  /* ---------- 10. TABLEAUX : ÉVITER LES COUPURES ---------- */
  table {
    page-break-inside: auto;
  }
  tr {
    page-break-inside: avoid;
    page-break-after: auto;
  }
  thead {
    display: table-header-group;
  }
  tfoot {
    display: table-footer-group;
  }

  /* ---------- 11. IMAGES ---------- */
  img {
    max-width: 100% !important;
    page-break-inside: avoid;
  }

  /* ---------- 12. SIGNATURES (ne pas couper) ---------- */
  .signature-block,
  [class*="signature"] {
    page-break-inside: avoid !important;
    break-inside: avoid !important;
  }
  .print-footer {
    position: static !important;
    bottom: auto !important;
    left: auto !important;
    right: auto !important;
    width: 100% !important;
    visibility: visible !important;
    display: block !important;
    background: #ffffff !important;
    color: #000000 !important;
    font-size: 8px !important;
    text-align: center !important;
    padding: 2mm 0 0 0 !important;
    border-top: 1px solid #cccccc !important;
    z-index: auto !important;
    page-break-after: auto !important;
  }

  .print-footer * {
    visibility: visible !important;
    color: #000000 !important;
    background: transparent !important;
  }

  .print-container,
  .print-area,
  .printable {
    padding-bottom: 0 !important;
  }
}

/* ============================================================
   STYLES ÉCRAN (non-print) — pour référence
   ============================================================ */
.print-container,
.print-area,
.printable {
  /* Rien de spécial à l'écran, juste des marqueurs */
}
/* ============================================================
   SYSTÈME DE THÈMES (Clair / Sombre)
   ============================================================ */
:root {
  /* Thème SOMBRE (défaut actuel) */
  --bg-body: #111827;
  --bg-card: #1f2937;
  --bg-card-hover: #374151;
  --bg-input: #1f2937;
  --bg-header: #1f2937;
  --text-primary: #f9fafb;
  --text-secondary: #9ca3af;
  --text-muted: #6b7280;
  --border-primary: rgba(255, 255, 255, 0.08);
  --border-hover: rgba(255, 255, 255, 0.15);
  --accent: #3b82f6;
  --accent-dark: #2563eb;
}

.theme-light {
  /* Thème CLAIR */
  --bg-body: #f8fafc;
  --bg-card: #ffffff;
  --bg-card-hover: #f1f5f9;
  --bg-input: #ffffff;
  --bg-header: #ffffff;
  --text-primary: #0f172a;
  --text-secondary: #64748b;
  --text-muted: #94a3b8;
  --border-primary: #e2e8f0;
  --border-hover: #cbd5e1;
  --accent: #3b82f6;
  --accent-dark: #2563eb;
}

/* Classe utilitaire pour appliquer le thème */
body {
  background-color: var(--bg-body);
  color: var(--text-primary);
  transition:
    background-color 0.3s ease,
    color 0.3s ease;
}

/* Classes utilitaires de thème */
.theme-bg-body {
  background-color: var(--bg-body);
}
.theme-bg-card {
  background-color: var(--bg-card);
}
.theme-bg-card-hover {
  background-color: var(--bg-card-hover);
}
.theme-bg-input {
  background-color: var(--bg-input);
}
.theme-bg-header {
  background-color: var(--bg-header);
}
.theme-text {
  color: var(--text-primary);
}
.theme-text-secondary {
  color: var(--text-secondary);
}
.theme-text-muted {
  color: var(--text-muted);
}
.theme-border {
  border-color: var(--border-primary);
}
.theme-border-hover {
  border-color: var(--border-hover);
}
.theme-accent {
  color: var(--accent);
}
.theme-bg-accent {
  background-color: var(--accent);
}
