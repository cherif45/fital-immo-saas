/* ============================================================
   SYSTÈME DE THÈMES (Clair / Sombre)
   ============================================================ */
:root {
  /* Thème SOMBRE (défaut actuel) */
  --bg-body: #111827;
  --bg-card: #1F2937;
  --bg-card-hover: #374151;
  --bg-input: #1F2937;
  --bg-header: #1F2937;
  --text-primary: #F9FAFB;
  --text-secondary: #9CA3AF;
  --text-muted: #6B7280;
  --border-primary: rgba(255, 255, 255, 0.08);
  --border-hover: rgba(255, 255, 255, 0.15);
  --accent: #3B82F6;
  --accent-dark: #2563EB;
}

.theme-light {
  /* Thème CLAIR */
  --bg-body: #F8FAFC;
  --bg-card: #FFFFFF;
  --bg-card-hover: #F1F5F9;
  --bg-input: #FFFFFF;
  --bg-header: #FFFFFF;
  --text-primary: #0F172A;
  --text-secondary: #64748B;
  --text-muted: #94A3B8;
  --border-primary: #E2E8F0;
  --border-hover: #CBD5E1;
  --accent: #3B82F6;
  --accent-dark: #2563EB;
}

/* Classe utilitaire pour appliquer le thème */
body {
  background-color: var(--bg-body);
  color: var(--text-primary);
  transition: background-color 0.3s ease, color 0.3s ease;
}

/* Classes utilitaires de thème */
.theme-bg-body { background-color: var(--bg-body); }
.theme-bg-card { background-color: var(--bg-card); }
.theme-bg-card-hover { background-color: var(--bg-card-hover); }
.theme-bg-input { background-color: var(--bg-input); }
.theme-bg-header { background-color: var(--bg-header); }
.theme-text { color: var(--text-primary); }
.theme-text-secondary { color: var(--text-secondary); }
.theme-text-muted { color: var(--text-muted); }
.theme-border { border-color: var(--border-primary); }
.theme-border-hover { border-color: var(--border-hover); }
.theme-accent { color: var(--accent); }
.theme-bg-accent { background-color: var(--accent); }
