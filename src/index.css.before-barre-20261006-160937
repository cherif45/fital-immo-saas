@import "tailwindcss";

@layer base {
  :root {
    --font-sans: 'DM Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    --font-serif: 'Playfair Display', Georgia, serif;
    --font-mono: 'JetBrains Mono', monospace;
  }

  body {
    font-family: var(--font-sans);
    color: #F0EDE8;
    background-color: #0F1B2D;
    overflow-x: hidden;
  }

  h1, h2, h3, .font-display {
    font-family: var(--font-sans);
  }
}

/* ============================================================
   SCROLLBARS PERSONNALISÉES
   ============================================================ */
::-webkit-scrollbar {
  width: 6px;
  height: 6px;
}
::-webkit-scrollbar-track {
  background: rgba(15, 27, 45, 0.5);
}
::-webkit-scrollbar-thumb {
  background: #2A3F5C;
  border-radius: 9999px;
}
::-webkit-scrollbar-thumb:hover {
  background: #3A5270;
}

/* ============================================================
   IMPRESSION — STYLE UNIVERSEL POUR TOUS LES DOCUMENTS
   Compatible : fiches, quittances, contrats, bulletins, PV, etc.
   ============================================================ */
@media print {
  /* ---------- 1. FOND BLANC SUR TOUTE LA PAGE ---------- */
  html, body {
    background: #FFFFFF !important;
    color: #000000 !important;
    margin: 0 !important;
    padding: 0 !important;
    width: 100% !important;
    height: auto !important;
    overflow: visible !important;
    -webkit-print-color-adjust: exact !important;
    print-color-adjust: exact !important;
  }

  /* ---------- 2. CACHER TOUT PAR DÉFAUT ---------- */
  body * {
    visibility: hidden !important;
  }

  /* ---------- 3. AFFICHER UNIQUEMENT LES ZONES D'IMPRESSION ---------- */
  .print-container,
  .print-container *,
  .print-area,
  .print-area *,
  .printable,
  .printable * {
    visibility: visible !important;
  }

  /* ---------- 4. POSITIONNER LES ZONES D'IMPRESSION EN HAUT ---------- */
  .print-container,
  .print-area,
  .printable {
    position: absolute !important;
    left: 0 !important;
    top: 0 !important;
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 !important;
    padding: 12mm !important;
    background: #FFFFFF !important;
    color: #000000 !important;
    box-shadow: none !important;
    border: none !important;
    border-radius: 0 !important;
    overflow: visible !important;
    max-height: none !important;
    height: auto !important;
    font-size: 12px !important;
  }

  /* ---------- 5. NEUTRALISER LES MODALES PARENTS ---------- */
  /* Sortir les modales du mode fixed pour éviter les problèmes de clipping */
  .fixed,
  .fixed.inset-0,
  [class*="fixed"] {
    position: static !important;
    overflow: visible !important;
    background: transparent !important;
    backdrop-filter: none !important;
    padding: 0 !important;
    margin: 0 !important;
    max-height: none !important;
    height: auto !important;
    max-width: none !important;
    width: auto !important;
    z-index: auto !important;
    inset: auto !important;
  }

  /* ---------- 6. COULEURS ET BORDURES FORCÉES ---------- */
  .print-container *,
  .print-area *,
  .printable * {
    color: #000000 !important;
    background-color: transparent !important;
    border-color: #CCCCCC !important;
    box-shadow: none !important;
    text-shadow: none !important;
  }

  /* Tableaux */
  .print-container table,
  .print-area table,
  .printable table {
    border-collapse: collapse !important;
    width: 100% !important;
  }
  .print-container th,
  .print-container td,
  .print-area th,
  .print-area td,
  .printable th,
  .printable td {
    border: 1px solid #999999 !important;
    padding: 6px 8px !important;
    color: #000000 !important;
    background: #FFFFFF !important;
  }
  .print-container thead,
  .print-area thead,
  .printable thead {
    background: #EEEEEE !important;
    display: table-header-group !important;
  }
  .print-container thead *,
  .print-area thead *,
  .printable thead * {
    background: #EEEEEE !important;
    color: #000000 !important;
    font-weight: bold !important;
  }

  /* Fonds sombres des badges → gris clair */
  .print-container .bg-\[\#1E2E45\],
  .print-container .bg-\[\#162133\],
  .print-container .bg-\[\#0F1B2D\],
  .print-container .bg-\[\#0A111D\],
  .print-area .bg-\[\#1E2E45\],
  .print-area .bg-\[\#162133\],
  .print-area .bg-\[\#0F1B2D\],
  .print-area .bg-\[\#0A111D\],
  .printable .bg-\[\#1E2E45\],
  .printable .bg-\[\#162133\],
  .printable .bg-\[\#0F1B2D\],
  .printable .bg-\[\#0A111D\] {
    background: #F5F5F5 !important;
  }

  /* Texte blanc ou coloré → noir */
  .print-container [class*="text-white"],
  .print-container [class*="text-slate"],
  .print-container [class*="text-\\[\\#"],
  .print-area [class*="text-white"],
  .print-area [class*="text-slate"],
  .print-area [class*="text-\\[\\#"],
  .printable [class*="text-white"],
  .printable [class*="text-slate"],
  .printable [class*="text-\\[\\#"] {
    color: #000000 !important;
  }

  /* ---------- 7. CACHER LES ÉLÉMENTS NON IMPRIMABLES ---------- */
  .no-print,
  .no-print *,
  nav,
  aside,
  .sidebar {
    display: none !important;
  }

  /* ⚠️ Ne pas cacher "header" et "button" globalement — certains documents en ont besoin */

  /* ---------- 8. AFFICHER CE QUI DOIT L'ÊTRE ---------- */
  .print-only {
    display: block !important;
  }

  /* ---------- 9. SAUTS DE PAGE ---------- */
  .print-page-break {
    page-break-before: always !important;
    break-before: page !important;
  }
  .print-page {
    page-break-inside: avoid !important;
    break-inside: avoid !important;
  }

  /* ---------- 10. TABLEAUX : ÉVITER LES COUPURES ---------- */
  table {
    page-break-inside: auto;
  }
  tr {
    page-break-inside: avoid;
    page-break-after: auto;
  }
  thead {
    display: table-header-group;
  }
  tfoot {
    display: table-footer-group;
  }

  /* ---------- 11. IMAGES ---------- */
  img {
    max-width: 100% !important;
    page-break-inside: avoid;
  }

  /* ---------- 12. SIGNATURES (ne pas couper) ---------- */
  .signature-block,
  [class*="signature"] {
    page-break-inside: avoid !important;
    break-inside: avoid !important;
  }
    /* ---------- 13. PIED DE PAGE RÉPÉTÉ SUR CHAQUE PAGE ---------- */
  .print-footer {
    position: fixed !important;
    bottom: 0 !important;
    left: 0 !important;
    right: 0 !important;
    width: 100% !important;
    visibility: visible !important;
    display: block !important;
    background: #FFFFFF !important;
    color: #000000 !important;
    font-size: 8px !important;
    text-align: center !important;
    padding: 3mm 10mm 3mm 10mm !important;
    border-top: 1px solid #CCCCCC !important;
    z-index: 9999 !important;
    page-break-after: always !important;
  }

  .print-footer * {
    visibility: visible !important;
    color: #000000 !important;
    background: transparent !important;
  }

  /* Laisser de la place en bas du contenu pour ne pas être masqué par le pied de page */
  .print-container,
  .print-area,
  .printable {
    padding-bottom: 25mm !important;
  }


  /* ---------- 13. FORMAT A4 ---------- */
  @page {
    size: A4 portrait;
    margin: 10mm;
  }
}

