/* 1. PAS de scroll horizontal au niveau page (body, PAS #root) */
html, body {
  max-width: 100%;
  overflow-x: hidden;
}

/* 2. #root : laisse passer le contenu */
#root {
  max-width: 100%;
  min-width: 0;
}

/* 3. Enfants FLEX : peuvent se retrecir (fix min-width:auto) */
.flex > *,
.flex-1 > *,
.flex-col > * {
  min-width: 0;
}

/* 4. TOUS les wrappers de tableau : scroll horizontal interne */
div:has(> table),
div:has(> div > table),
div:has(> div > div > table),
[class*="overflow-x-auto"] {
  min-width: 0;
  max-width: 100%;
  overflow-x: auto !important;
  -webkit-overflow-scrolling: touch;
}

/* 5. Les tableaux debordent du wrapper (qui lui scrolle) */
table {
  min-width: 800px;
  max-width: none;
}

/* 6. Images / medias */
img, video, iframe {
  max-width: 100%;
  height: auto;
}

