/* BARRE SCROLL HORIZONTALE SUR LES TABLEAUX                    */
/* ============================================================ */

/* Tous les wrappers de tableaux = scrollables */
div:has(> table),
div:has(> div > table),
div:has(> div > div > table) {
  overflow-x: auto !important;
  overflow-y: visible !important;
  max-width: 100% !important;
  min-width: 0 !important;
  padding-bottom: 12px !important;   /* espace pour la barre */
}

/* Barre de scroll BIEN VISIBLE et large */
div:has(> table)::-webkit-scrollbar,
div:has(> div > table)::-webkit-scrollbar,
div:has(> div > div > table)::-webkit-scrollbar {
  height: 14px !important;
  display: block !important;
}

div:has(> table)::-webkit-scrollbar-track,
div:has(> div > table)::-webkit-scrollbar-track,
div:has(> div > div > table)::-webkit-scrollbar-track {
  background: rgba(201, 169, 110, 0.1) !important;
  border-radius: 8px !important;
}

div:has(> table)::-webkit-scrollbar-thumb,
div:has(> div > table)::-webkit-scrollbar-thumb,
div:has(> div > div > table)::-webkit-scrollbar-thumb {
  background: #C9A96E !important;
  border-radius: 8px !important;
  border: 2px solid rgba(15, 27, 45, 0.5) !important;
}

div:has(> table)::-webkit-scrollbar-thumb:hover,
div:has(> div > table)::-webkit-scrollbar-thumb:hover {
  background: #E8D5B0 !important;
}

/* Firefox */
div:has(> table),
div:has(> div > table) {
  scrollbar-width: thin;
  scrollbar-color: #C9A96E rgba(201, 169, 110, 0.1);
}

/* Tableaux : largeur mini pour forcer le scroll */
table {
  min-width: 900px;
}

