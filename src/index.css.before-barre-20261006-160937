/* ============================================================
   MIGRATION AUTOMATIQUE DES ACCENTS
   Ajouté le : chantier Thème Premium
   But : forcer l'utilisation de var(--accent) quand l'accent
         n'est PAS "gold" (défaut). Préserve l'identité FITAL
         par défaut, migre dynamiquement vers l'accent choisi.
   Méthode : override Tailwind hardcodé (bg-[#C9A96E], etc.)
   Sécurité : scopé à [data-accent]:not([data-accent="gold"])
   ============================================================ */

/* Ne s'applique QUE si l'accent est différent de "gold" */
[data-accent]:not([data-accent="gold"]) {

  /* ─── FONDS OR → FOND ACCENT ──────────────────────────── */
  .bg-\[\#C9A96E\]       { background-color: var(--accent) !important; }
  .bg-\[\#C9A96E\]\/10   { background-color: var(--accent-soft) !important; }
  .bg-\[\#C9A96E\]\/15   { background-color: var(--accent-soft) !important; }
  .bg-\[\#C9A96E\]\/20   { background-color: var(--accent-soft) !important; }
  .bg-\[\#C9A96E\]\/30   { background-color: var(--accent-border) !important; }

  /* ─── TEXTES OR → TEXTE ACCENT ────────────────────────── */
  .text-\[\#C9A96E\]     { color: var(--accent) !important; }
  .text-\[\#A07840\]     { color: var(--accent-dark) !important; }
  .text-\[\#E8D5B0\]     { color: var(--accent) !important; }
  .text-\[\#E8A84A\]     { color: var(--accent) !important; }

  /* ─── BORDURES OR → BORDURE ACCENT ────────────────────── */
  .border-\[\#C9A96E\]      { border-color: var(--accent) !important; }
  .border-\[\#C9A96E\]\/15  { border-color: var(--accent-border) !important; }
  .border-\[\#C9A96E\]\/20  { border-color: var(--accent-border) !important; }
  .border-\[\#C9A96E\]\/30  { border-color: var(--accent-border) !important; }
  .border-\[\#C9A96E\]\/40  { border-color: var(--accent-border) !important; }
  .border-\[\#C9A96E\]\/50  { border-color: var(--accent) !important; }

  /* ─── GRADIENTS OR → GRADIENT ACCENT ──────────────────── */
  .from-\[\#C9A96E\]     { --tw-gradient-from: var(--accent) !important; }
  .to-\[\#A07840\]       { --tw-gradient-to: var(--accent-dark) !important; }
  .from-\[\#C9A96E\]\/20 { --tw-gradient-from: var(--accent-soft) !important; }
  .to-\[\#C9A96E\]\/10   { --tw-gradient-to: var(--accent-soft) !important; }
  .via-\[\#E8A84A\]\/20  { --tw-gradient-via: var(--accent-soft) !important; }

  /* ─── OMBRES OR → OMBRE ACCENT ────────────────────────── */
  .shadow-\[\#C9A96E\]\/20 { box-shadow: 0 4px 14px 0 var(--accent-glow) !important; }
  .shadow-\[\#C9A96E\]\/40 { box-shadow: 0 8px 20px 0 var(--accent-glow) !important; }

  /* ─── RING OR → RING ACCENT ───────────────────────────── */
  .ring-\[\#C9A96E\]     { --tw-ring-color: var(--accent) !important; }

  /* ─── HOVER BORDER OR → HOVER BORDER ACCENT ───────────── */
  .hover\:border-\[\#C9A96E\]:hover         { border-color: var(--accent) !important; }
  .hover\:border-\[\#C9A96E\]\/50:hover     { border-color: var(--accent-border) !important; }
  .hover\:text-\[\#C9A96E\]:hover           { color: var(--accent) !important; }
  .hover\:bg-\[\#C9A96E\]\/20:hover         { background-color: var(--accent-soft) !important; }
}

