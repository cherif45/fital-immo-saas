/* Transition fluide lors du changement d'accent (uniquement les propriétés liées) */
* {
  transition-property: background-color, border-color, color, fill, stroke;
  transition-duration: 200ms;
  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
}

/* Fallback : composants qui utilisent var(--accent) changent automatiquement */
.theme-accent       { color: var(--accent); }
.theme-bg-accent    { background-color: var(--accent); }
.theme-border-accent { border-color: var(--accent); }

