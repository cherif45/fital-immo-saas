# Clé API Gemini (optionnel — relances IA, fonctionne en local avec server.ts)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# URL de l'application (production)
APP_URL="https://votre-domaine.vercel.app"

# Supabase — OBLIGATOIRE pour un déploiement multi-utilisateurs
# Créez un projet sur https://supabase.com puis copiez ces valeurs
VITE_SUPABASE_URL="https://votre-projet.supabase.co"
VITE_SUPABASE_ANON_KEY="votre_cle_anon_publique_supabase"

# À configurer aussi sur Vercel : Settings > Environment Variables
# Puis exécutez supabase/schema.sql dans Supabase SQL Editor
# Et supabase/migrations/20260916_profiles_insert_and_bootstrap.sql
